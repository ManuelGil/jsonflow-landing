# ------------------------------------------------------
# Repository-scoped pnpm configuration
# ------------------------------------------------------
# This project uses pnpm as the only supported package manager.
# This file defines safe, explicit defaults for local and CI usage.
# ------------------------------------------------------

# Security
strict-ssl=true

# Determinism & hygiene
fund=false
audit=false
loglevel=warn

# Enforce pnpm usage
# The package manager is pinned via the "packageManager" field in package.json
# (Corepack spec). There is no valid `package-manager` key in .npmrc.
